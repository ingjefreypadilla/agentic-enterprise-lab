# ---------- Stage 1: Builder ----------
FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY services/agent-runtime/pyproject.toml .
COPY services/agent-runtime/Poetry.lock ./ 2>/dev/null || true
RUN pip wheel --no-cache-dir --wheel-dir=/wheels .

# ---------- Stage 2: Final Runtime ----------
FROM python:3.12-slim-bookworm AS runtime

WORKDIR /app

# Install Python runtime dependencies only
COPY services/agent-runtime/pyproject.toml .
COPY services/agent-runtime/requirements.txt ./
RUN pip wheel --no-cache-dir --no-deps --wheel-dir=/wheels .
COPY services/agent-runtime/build/wheels/*.whl /wheels/*.whl
RUN pip install --no-cache-dir /wheels/*.whl

# Create non-root user with least privileges
RUN groupadd -r agentgroup && useradd -g agentgroup -u 100000 -s /bin/bash -r -d /app agentuser
USER agentuser

# Copy application code
COPY services/agent-runtime/app ./app
COPY services/agent-runtime/gunicorn.conf.py ./gunicorn.conf.py

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]